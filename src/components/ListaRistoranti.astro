---
import Icon from "./Icon.astro";
---

<div x-data="listaRistoranti" style="display: contents">
  <div x-show="mode === 'list'">
    <button class="lista-risto-add" type="button" @click="openAdd()">
      <Icon name="plus" />
      Aggiungi ristorante
    </button>

    <p class="lista-risto-empty" x-show="items.length === 0">
      Nessun ristorante aggiunto ancora.
    </p>
    <div>
      <template x-for="(item, i) in items" :key="item.id">
        <div class="risto-item">
          <div class="risto-n" x-text="num(i)"></div>
          <div class="risto-info">
            <div class="risto-name" x-text="item.name"></div>
            <template x-if="item.type">
              <div class="risto-type" x-text="item.type"></div>
            </template>
            <template x-if="item.addr">
              <div class="risto-addr" x-text="item.addr"></div>
            </template>
            <template x-if="item.when">
              <div class="risto-when" x-text="item.when"></div>
            </template>
            <div class="lista-risto-actions">
              <button
                class="lista-risto-btn lista-risto-btn--edit"
                type="button"
                @click="openEdit(item)"
                :aria-label="`Modifica ${item.name}`"
              >
                <Icon name="edit" />
                Modifica
              </button>
              <button
                class="lista-risto-btn lista-risto-btn--delete"
                type="button"
                @click="remove(item.id)"
                :aria-label="`Elimina ${item.name}`"
              >
                <Icon name="trash" />
                Elimina
              </button>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>

  <template x-if="mode === 'form'">
    <div>
      <p
        class="lista-risto-form-title"
        x-text="editingId ? 'Modifica ristorante' : 'Nuovo ristorante'"
      ></p>
      <form class="hotel-form" @submit.prevent="save()" novalidate>
        <div class="hotel-form-group">
          <label class="hotel-form-label" for="rf-name">
            Nome{" "}
            <span class="hotel-form-required" aria-hidden="true">*</span>
          </label>
          <input
            id="rf-name"
            class="hotel-form-input"
            :class="{ 'hotel-form-input--error': nameErr }"
            type="text"
            x-model="form.name"
            @input="nameErr = ''"
            placeholder="es. Trattoria da Enzo"
            aria-required="true"
          />
          <template x-if="nameErr">
            <span class="hotel-form-error" role="alert" x-text="nameErr"></span>
          </template>
        </div>

        <div class="hotel-form-group">
          <label class="hotel-form-label" for="rf-type">Tipo di cucina</label>
          <input
            id="rf-type"
            class="hotel-form-input"
            type="text"
            x-model="form.type"
            placeholder="es. Emiliana tradizionale"
          />
        </div>

        <div class="hotel-form-group">
          <label class="hotel-form-label" for="rf-addr">Indirizzo</label>
          <input
            id="rf-addr"
            class="hotel-form-input"
            type="text"
            x-model="form.addr"
            placeholder="es. Via Coltellini 17, Modena"
          />
        </div>

        <div class="hotel-form-group">
          <label class="hotel-form-label" for="rf-when">Quando</label>
          <input
            id="rf-when"
            class="hotel-form-input"
            type="text"
            x-model="form.when"
            placeholder="es. Venerdì sera · ore 20:00 · prenotato"
          />
        </div>

        <div class="hotel-form-actions">
          <button class="hotel-form-submit" type="submit">
            <Icon name="check" />
            Salva
          </button>
          <button class="lista-risto-cancel" type="button" @click="cancel()">
            Annulla
          </button>
        </div>
      </form>
    </div>
  </template>
</div>
