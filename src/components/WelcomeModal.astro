---
import Icon from "./Icon.astro";
import Decor from "./Decor.astro";
import { EDITION as EDIZIONE } from "../lib/edition.ts";

const SITO = "https://www.festivalfilosofia.it/";
---

<!-- Shown once per edition: returning visitors are hidden by
     html[data-welcome="seen"], set by the head script in Layout.astro. -->
<div
  x-data="welcomeModal"
  data-edition={EDIZIONE.anno}
  class="ff-modal-overlay open"
  :class="{ open }"
  aria-hidden="false"
  :aria-hidden="String(!open)"
  @click="close()"
  @keydown.window="onKeyDown($event)"
>
  <div
    x-ref="card"
    class="ff-modal-card"
    role="dialog"
    aria-modal="true"
    aria-labelledby="ff-modal-title"
    @click.stop
  >
    <button
      x-ref="close"
      class="ff-modal-close"
      type="button"
      @click="close()"
      aria-label="Chiudi l'avviso"
    >
      <Icon name="x" />
    </button>

    <p class="ff-modal-eyebrow">{EDIZIONE.numero} edizione · {EDIZIONE.anno}</p>
    <h2 class="ff-modal-title" id="ff-modal-title">
      Benvenuti al festivalfilosofia {EDIZIONE.anno}
    </h2>
    <p class="ff-modal-body">
      Il programma non è ancora stato pubblicato: intanto puoi annotare
      alloggio, ristoranti e appunti, e ritrovarli qui durante il festival.
    </p>

    <div class="ff-modal-next">
      <Decor class="ff-modal-decor" />
      <p class="ff-modal-eyebrow">il tema</p>
      <p class="ff-modal-tema">{EDIZIONE.tema}</p>
      <p class="ff-modal-date">{EDIZIONE.date}</p>
      <p class="ff-modal-cities">{EDIZIONE.città}</p>
    </div>

    <div class="ff-modal-actions">
      <button class="ff-modal-btn" type="button" @click="close()">
        Inizia
      </button>
      <a
        class="ff-modal-link"
        href={SITO}
        target="_blank"
        rel="noopener noreferrer"
      >
        Sito ufficiale
      </a>
    </div>
  </div>
</div>
