---
import Icon from "../Icon.astro";
import { url } from "../../lib/url.ts";
---

<!-- Hotel details live in localStorage: the server renders the empty state,
     Alpine swaps in the saved card if there is one. -->
<div x-data="hotelSection" style="display: contents">
  <p class="hotel-empty" x-show="!data">
    Nessun alloggio configurato.{" "}
    <a href={url("hotel")} class="hotel-empty-link">
      Inserisci i dati →
    </a>
  </p>

  <template x-if="data">
    <div style="display: contents">
      <div class="hotel-wrap">
        <div class="hotel-head">
          <div class="hotel-name" x-text="data.nome"></div>
          <template x-if="data.indirizzo">
            <div class="hotel-addr" x-text="data.indirizzo"></div>
          </template>
          <template x-if="timeLine">
            <div class="hotel-tag" x-text="timeLine"></div>
          </template>
        </div>
        <template x-if="mapUrl">
          <iframe
            class="hotel-map-iframe"
            :src="mapUrl"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            :title="`Mappa di ${data.nome}`"></iframe>
        </template>
        <template x-if="!mapUrl">
          <div class="hotel-map-ph">
            <svg
              viewBox="0 0 380 150"
              preserveAspectRatio="none"
              xmlns="http://www.w3.org/2000/svg"
              aria-hidden="true"
            >
              <rect width="380" height="150" fill="#e8e8e4" />
              <rect x="0" y="60" width="380" height="8" fill="#d4d0cc" />
              <rect x="0" y="100" width="380" height="6" fill="#d4d0cc" />
              <rect x="70" y="0" width="6" height="150" fill="#d4d0cc" />
              <rect x="170" y="0" width="4" height="150" fill="#d4d0cc" />
              <rect x="270" y="0" width="6" height="150" fill="#d4d0cc" />
              <rect x="80" y="20" width="65" height="32" rx="2" fill="#ccc9c6" />
              <rect x="80" y="70" width="65" height="22" rx="2" fill="#ccc9c6" />
              <rect x="180" y="30" width="55" height="22" rx="2" fill="#ccc9c6" />
              <rect x="180" y="68" width="55" height="28" rx="2" fill="#ccc9c6" />
              <rect x="280" y="18" width="70" height="36" rx="2" fill="#ccc9c6" />
              <rect x="280" y="70" width="70" height="22" rx="2" fill="#ccc9c6" />
              <circle cx="190" cy="78" r="14" fill="none" stroke="#c0392b" stroke-width="2" />
              <circle cx="190" cy="78" r="5" fill="#c0392b" />
            </svg>
            <div class="hotel-map-label">
              <Icon name="map-pin" />
              <span>Nessuna mappa inserita</span>
            </div>
          </div>
        </template>
      </div>
      <template x-if="data.ref">
        <p class="hotel-note" x-text="data.ref"></p>
      </template>
      <template x-if="data.note">
        <p class="hotel-note" x-text="data.note"></p>
      </template>
      <a href={url("hotel")} class="hotel-edit-link">
        <Icon name="edit" />
        Modifica
      </a>
    </div>
  </template>
</div>
