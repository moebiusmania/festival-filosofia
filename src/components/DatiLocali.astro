---
import Icon from "./Icon.astro";
---

<div class="dati-locali-actions" x-data="datiLocali">
  <template x-if="deleted">
    <p class="dati-locali-done">Dati eliminati.</p>
  </template>
  <button
    class="dati-locali-delete-btn"
    type="button"
    x-show="!deleted"
    @click="remove()"
  >
    <Icon name="trash" />
    Cancella tutti i dati locali
  </button>
</div>
