---
import "leaflet/dist/leaflet.css";
import "../styles/style.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DecorSprite from "../components/DecorSprite.astro";
import { url } from "../lib/url.ts";
import { EDITION } from "../lib/edition.ts";

interface Props {
  // Play the header intro (letters, motif drawing). Only the
  // home page asks for it, so it doesn't replay on every navigation.
  intro?: boolean;
}
const { intro = false } = Astro.props;
---

<html lang="it" data-theme="light" data-decor="mito">
  <head>
    <!-- Apply saved theme and decoration, and whether this edition's welcome
         was already shown, before first paint. -->
    <script is:inline define:vars={{ edition: String(EDITION.anno) }}>
      (function(){try{var h=document.documentElement,s=localStorage,t=s.getItem('ff-theme'),d=s.getItem('ff-decor');if(t==='dark')h.setAttribute('data-theme','dark');if(d==='caos')h.setAttribute('data-decor','caos');if(s.getItem('ff-welcome')===edition)h.setAttribute('data-welcome','seen');}catch(e){}})();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="ff2027" />
    <link rel="manifest" href={url("manifest.json")} />
    <link rel="icon" type="image/svg+xml" href={url("icons/icon.svg")} />
    <link rel="apple-touch-icon" href={url("icons/icon.svg")} />
    <!-- Fonts from Bunny Fonts: a GDPR-friendly Google Fonts mirror that
         doesn't log visitors. Icons are inlined SVG (components/Icon.astro). -->
    <link rel="preconnect" href="https://fonts.bunny.net" />
    <link
      rel="stylesheet"
      href="https://fonts.bunny.net/css?family=eb-garamond:400,400i,500,500i,600|libre-franklin:300,400,500&display=swap"
    />
    <title>festivalfilosofia 2027 · mito</title>
  </head>
  <body>
    <DecorSprite />
    <div class:list={["ff-app", { "ff-app--intro": intro }]}>
      <Header />
      <slot />
      <Footer />
      <slot name="after" />
    </div>
  </body>
</html>
