---
import "leaflet/dist/leaflet.css";
import "../styles/style.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { url } from "../lib/url.ts";
---

<html lang="it" data-theme="light">
  <head>
    <script is:inline>
      (function(){var t=localStorage.getItem('ff-theme');if(t==='dark')document.documentElement.setAttribute('data-theme','dark');})();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="apple-mobile-web-app-title" content="ff2026" />
    <link rel="manifest" href={url("manifest.json")} />
    <link rel="icon" type="image/svg+xml" href={url("icons/icon.svg")} />
    <link rel="apple-touch-icon" href={url("icons/icon.svg")} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3/dist/tabler-icons.min.css"
    />
    <title>festivalfilosofia 2026 · caos</title>
  </head>
  <body>
    <div class="ff-app">
      <Header />
      <slot />
      <Footer />
      <slot name="after" />
    </div>
  </body>
</html>
