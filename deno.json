{
  "nodeModulesDir": "manual",
  "tasks": {
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "test": "deno test --allow-read --allow-env tests/"
  },
  "lint": {
    "rules": {
      "tags": ["fresh", "recommended"]
    }
  },
  "exclude": ["**/_fresh/*"],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.8",
    "preact/hooks": "npm:preact@^10.29.8/hooks",
    "@preact/signals": "npm:@preact/signals@^2.11.2",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.3.6",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "preact-render-to-string": "npm:preact-render-to-string@^6.7.0",
    "leaflet": "npm:leaflet@^1.9.4",
    "@types/leaflet": "npm:@types/leaflet@^1.9.22"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a", "img", "source", "body", "html", "head",
      "title", "meta", "script", "link", "style",
      "base", "noscript", "template", "iframe"
    ],
    "types": ["vite/client"]
  }
}
